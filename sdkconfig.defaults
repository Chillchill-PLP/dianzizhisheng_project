# ESP32-S3-N16R8: 16 MB flash and 8 MB Octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_SR_MN_CN_MULTINET5_RECOGNITION_QUANT8=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_PLAYER_MIC_CONNECTED=y
CONFIG_PLAYER_MIC_BCLK_GPIO=5
CONFIG_PLAYER_MIC_WS_GPIO=4
CONFIG_PLAYER_MIC_DATA_GPIO=6

# microSD filenames are exposed to application code as UTF-8 and may be up to 255 bytes.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# GPIO20 is the keypad R4; keep console on UART only.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
